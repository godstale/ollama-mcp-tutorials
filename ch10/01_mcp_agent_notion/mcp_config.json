{
  "mcpServers": {
    "weather": {
        "command": "python",
        "args": ["./mcp_server/mcp_server_weather.py"],
        "transport": "stdio"
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@ramidecodes/mcp-server-notion@latest",
        "--api-key=YOUR_NOTION_API_KEY"
      ],
      "transport": "stdio"
    }
  }
}